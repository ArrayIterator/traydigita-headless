{
    "name": "traydigita/headless",
    "description": "Traydigita Headless WordPress Plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Traydigita",
            "email": "traydigita@gmail.com",
            "homepage": "https://traydigita.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/psr7": "^3.0.0",
        "ext-mysqli": "*",
        "php-di/php-di": "^7.1"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.11.2",
        "phpstan/phpstan": "^2.1.0",
        "slevomat/coding-standard": "^8.15.0"
    },
    "scripts": {
        "lint": [
            "phpcs --standard=phpcs.xml.dist --extensions=php --ignore=*/vendor/*,*/node_modules/* ."
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true
        },
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": {
            "TrayDigita\\WP\\Headless\\Resource\\": "src/",
            "TrayDigita\\WP\\Headless\\": "libs/"
        },
        "files": [
            "Headless.php"
        ]
    }
}
